{
  "name": "creative-backlog-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Creative Request Tracker & WA Bot — backlog tracker tim Creative (Next.js + Google Sheets + WhatsApp)",
  "scripts": {
