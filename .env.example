# Salin ke .env.local (lokal) atau isi di Vercel → Project → Settings → Environment Variables.

# --- Database: Google Sheets -------------------------------------------------
SPREADSHEET_ID=1THrfMECihSohopWwCfgL91mGP5RsUl8YTBRW01VUbSE
# Service account Google Cloud (Sheets API aktif). Share spreadsheet ke email ini sebagai Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=creative-tracker@nama-project.iam.gserviceaccount.com
# Private key dari file JSON service account. Di Vercel, tempel apa adanya (boleh multi-baris atau dengan \n).
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Login Google (NextAuth) ----------------------------------------------------
# OAuth Client ID (tipe Web application). Redirect URI: https://<domain-vercel>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Acak, minimal 32 karakter: openssl rand -base64 32
NEXTAUTH_SECRET=
# URL produksi, contoh https://creative-tracker.vercel.app
NEXTAUTH_URL=
# Domain email yang boleh login (pisahkan dengan koma). Email lain boleh masuk bila terdaftar di Master_PIC/Master_Tim.
ALLOWED_DOMAINS=heymale.id

# --- WhatsApp gateway -------------------------------------------------------------
# fonnte | wablas | none
WA_PROVIDER=fonnte
WA_TOKEN=
# Khusus wablas, contoh https://jkt.wablas.com/api/send-message
WA_API_URL=
# true = pesan hanya dicatat di Log_WA (default true bila WA_TOKEN kosong)
WA_DRY_RUN=true
# Kunci rahasia webhook pesan masuk: set URL webhook di gateway ke https://<domain>/api/wa/webhook?key=<WEBHOOK_KEY>
WEBHOOK_KEY=

# --- Cron (reminder, digest, rekap mingguan) --------------------------------------
# Vercel otomatis mengirim header Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# --- Lain-lain -----------------------------------------------------------------
# URL yang dipakai di link pesan WA (default = NEXTAUTH_URL)
APP_URL=
# Mode demo: data contoh di memori + login pilih persona. JANGAN aktifkan di produksi.
DEMO_MODE=false
