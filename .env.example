# Salin ke .env.local (lokal) atau isi di Vercel → Project → Settings → Environment Variables.

# --- Database: Google Sheets -------------------------------------------------
SPREADSHEET_ID=1THrfMECihSohopWwCfgL91mGP5RsUl8YTBRW01VUbSE
# Service account Google Cloud (Sheets API aktif). Share spreadsheet ke client_email-nya sebagai Editor.
# Paling mudah: tempel SELURUH isi file JSON service account di sini.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Alternatif (bila tidak memakai GOOGLE_SERVICE_ACCOUNT_JSON):
# GOOGLE_SERVICE_ACCOUNT_EMAIL=creative-tracker@nama-project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Login email + password ---------------------------------------------------
# Rahasia penandatangan sesi, acak minimal 32 karakter. Buat dengan salah satu:
#   PowerShell : $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
#   Mac/Linux  : openssl rand -base64 32
# (mengganti nilai ini = semua user harus login ulang)
AUTH_SECRET=
# Superadmin awal. Login pertama memakai password ini, lalu wajib membuat password pribadi.
# Setelah itu SUPERADMIN_PASSWORD boleh dihapus (atau disimpan sebagai akses darurat).
SUPERADMIN_EMAIL=dodi.wahyono@worldwhiteenterprise.com
SUPERADMIN_PASSWORD=

# --- WhatsApp gateway -------------------------------------------------------------
# fonnte | wablas | none
WA_PROVIDER=fonnte
WA_TOKEN=
# Khusus wablas, contoh https://jkt.wablas.com/api/send-message
WA_API_URL=
# true = pesan hanya dicatat di Log_WA (default true bila WA_TOKEN kosong)
WA_DRY_RUN=true
# Kunci rahasia webhook pesan masuk: set URL webhook di gateway ke https://<domain>/api/wa/webhook?key=<WEBHOOK_KEY>
WEBHOOK_KEY=

# --- Cron (reminder, digest, rekap mingguan) --------------------------------------
# Vercel otomatis mengirim header Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# --- Lain-lain -----------------------------------------------------------------
# URL produksi, dipakai di link pesan WA, contoh https://creative-tracker.vercel.app
APP_URL=
# Mode demo: data contoh di memori + akun demo (password demo1234). JANGAN aktifkan di produksi.
DEMO_MODE=false
